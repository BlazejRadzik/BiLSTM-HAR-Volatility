        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import copy\n",
        "\n",
        "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "def get_final_data():\n",
        "    def process(symbol, start, end):\n",
        "        df = yf.Ticker(symbol).history(start=start, end=end)\n",
        "        df['Ret'] = np.log(df['Close'] / df['Close'].shift(1))\n",
        "        df['Parkinson'] = ((np.log(df['High'] / df['Low'])**2) / (4 * np.log(2))) * 10000\n",
        "        df['Neg_Ret'] = np.where(df['Ret'] < 0, df['Ret'], 0)\n",
        "        df['HV_5'] = df['Parkinson'].rolling(5).mean()\n",
        "        df['HV_22'] = df['Parkinson'].rolling(22).mean()\n",
        "        return df.dropna()\n",
        "\n",
        "    spy = process(\"SPY\", \"2000-01-01\", \"2009-12-31\")",
        "    epol = process(\"EPOL\", \"2010-01-01\", \"2024-01-01\")\n",
        "    return spy, epol\n",
        "\n",
        "data_us, data_pl = get_final_data()\n",
        "\n",
        "class DeepVolModelFinal(nn.Module):\n",
        "    def __init__(self, input_dim=5, hidden_dim=32):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(input_dim, hidden_dim, num_layers=2, batch_first=True, bidirectional=True, dropout=0.3)\n",
        "        self.attention = Attention(hidden_dim)\n",
        "        self.fc = nn.Sequential(nn.Linear(hidden_dim * 2, 1), nn.Softplus())\n",
        "    def forward(self, x):\n",
        "        lstm_out, _ = self.lstm(x)\n",
        "        return self.fc(self.attention(lstm_out))\n",
        "\n",
        "def create_final_seq(df, seq_len=10):\n",
        "    X, y = [], []\n",
        "    v, r, nr, h5, h22 = df['Parkinson'].values, df['Ret'].values, df['Neg_Ret'].values, df['HV_5'].values, df['HV_22'].values\n",
        "    for i in range(len(df) - seq_len):\n",
        "        feat = np.column_stack((v[i:i+seq_len], r[i:i+seq_len], nr[i:i+seq_len], h5[i:i+seq_len], h22[i:i+seq_len]))\n",
        "        X.append(feat)\n",
        "        y.append(v[i+seq_len])\n",
        "    return torch.tensor(np.array(X), dtype=torch.float32).to(DEVICE), torch.tensor(np.array(y), dtype=torch.float32).to(DEVICE)\n",
        "\n"
      ]
