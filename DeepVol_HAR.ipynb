        "!pip install yfinance pandas numpy scikit-learn matplotlib scipy tqdm -q\n",
        "\n",
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import torch.optim as optim\n",
        "import torch.nn.utils as nn_utils\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from scipy.stats import t\n",
        "from tqdm import tqdm\n",
        "import warnings\n",
        "import copy\n",
        "\n",
        "warnings.filterwarnings('ignore')\n",
        "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "torch.manual_seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "# =========================\n",
        "# DIEBOLD-MARIANO\n",
        "# =========================\n",
        "def diebold_mariano_test(target, f1, f2, lag=1):\n",
        "    e1 = target / f1 - np.log(target / f1) - 1\n",
        "    e2 = target / f2 - np.log(target / f2) - 1\n",
        "    d = e1 - e2\n",
        "\n",
        "    T = len(d)\n",
        "    mean_d = np.mean(d)\n",
        "\n",
        "    gamma_0 = np.var(d, ddof=1)\n",
        "    gamma = 0\n",
        "\n",
        "    for l in range(1, lag+1):\n",
        "        cov = np.cov(d[l:], d[:-l], ddof=1)[0,1]\n",
        "        gamma += (1 - l/(lag+1)) * cov\n",
        "\n",
        "    var_d = (gamma_0 + 2*gamma) / T\n",
        "\n",
        "    if var_d == 0:\n",
        "        return 0, 1.0\n",
        "\n",
        "    dm_stat = mean_d / np.sqrt(var_d)\n",
        "    p_value = 2 * (1 - t.cdf(np.abs(dm_stat), df=T-1))\n",
        "\n",
        "    return dm_stat, p_value\n",
        "\n",
        "# =========================\n",
        "# QLIKE\n",
        "# =========================\n",
        "def qlike(y, f):\n",
        "    y = np.clip(y, 1e-6, None)\n",
        "    f = np.clip(f, 1e-6, None)\n",
        "    return np.mean(y/f - np.log(y/f) - 1)\n",
        "\n",
        "def qlike_torch(p, t_tgt):\n",
        "    p = torch.clamp(p, min=1e-6)\n",
        "    t_tgt = torch.clamp(t_tgt, min=1e-6)\n",
        "    return torch.mean(t_tgt/p - torch.log(t_tgt/p) - 1)\n",
        "\n",
        "# =========================\n",
        "# MODEL\n",
        "# =========================\n",
        "class Attention(nn.Module):\n",
        "    def __init__(self, hidden_dim):\n",
        "        super().__init__()\n",
        "        self.attn = nn.Linear(hidden_dim*2, 1)\n",
        "\n",
        "    def forward(self, x):\n",
        "        w = torch.softmax(self.attn(x).squeeze(-1), dim=1)\n",
        "        context = torch.bmm(w.unsqueeze(1), x).squeeze(1)\n",
        "        return context, w\n",
        "\n",
        "class DeepVolEngine(nn.Module):\n",
        "    def __init__(self, input_dim):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(input_dim, 64, num_layers=2,\n",
        "                            batch_first=True, bidirectional=True, dropout=0.3)\n",
        "        self.attn = Attention(64)\n",
        "        self.fc = nn.Sequential(\n",
        "            nn.Linear(128, 32),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(32, 1),\n",
        "            nn.Softplus()\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        out, _ = self.lstm(x)\n",
        "        ctx, w = self.attn(out)\n",
        "        return self.fc(ctx), w\n",
        "\n",
        "# =========================\n",
        "# DATA\n",
        "# =========================\n",
        "def prepare_data(symbol):\n",
        "    df = yf.Ticker(symbol).history(start=\"2010-01-01\", end=\"2024-01-01\")\n",
        "\n",
        "    df['RV'] = ((np.log(df['High']/df['Low'])**2)/(4*np.log(2))) * 10000\n",
        "\n",
        "    df['RV_lag1'] = df['RV'].shift(1)\n",
        "    df['RV_week'] = df['RV'].rolling(5).mean().shift(1)\n",
        "    df['RV_month'] = df['RV'].rolling(22).mean().shift(1)\n",
        "\n",
        "    df['Ret'] = np.log(df['Close']/df['Close'].shift(1))\n",
        "    df['Neg_Ret'] = np.where(df['Ret'] < 0, df['Ret']**2, 0)\n",
        "\n",
        "    return df.dropna()\n",
        "\n",
        "def create_seq(data, features, target, seq_len):\n",
        "    X, y = [], []\n",
        "    for i in range(len(data) - seq_len):\n",
        "        X.append(data[features].iloc[i:i+seq_len].values)\n",
        "        y.append(data[target].iloc[i+seq_len])\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "# =========================\n",
        "# MAIN (FULL DAILY ROLLING OS)\n",
        "# =========================\n",
        "torch.backends.cudnn.benchmark = True\n",
        "if torch.cuda.is_available():\n",
        "    torch.set_float32_matmul_precision('high')\n",
        "\n",
        "TICKERS = [\"SPY\", \"EWG\", \"EPOL\", \"EEM\"]\n",
        "SEQ_LEN = 15\n",
        "\n",
        "for ticker in TICKERS:\n",
        "\n",
        "    df = prepare_data(ticker)\n",
        "\n",
        "    features = ['RV','Ret','Neg_Ret','RV_lag1','RV_week','RV_month']\n",
        "    X, y = create_seq(df, features, 'RV', SEQ_LEN)\n",
        "\n",
        "    start = int(len(X) * 0.6)\n",
        "\n",
        "    har_preds = []\n",
        "    dl_preds = []\n",
        "    y_true = []\n",
        "\n",
        "    print(f\"\\nRozpoczęto rygorystyczny Daily Walk-Forward dla {ticker}...\")\n",
        "\n",
        "    amp_scaler = torch.amp.GradScaler('cuda') if torch.cuda.is_available() else None\n",
        "\n",
        "    for t_idx in tqdm(range(start, len(X)-1), desc=f\"Ewaluacja {ticker}\"):\n",
        "        \n",
        "        torch.manual_seed(42)\n",
        "        np.random.seed(42)\n",
        "\n",
        "        # ================= HAR (Without JENSENA error) =================\n",
        "        X_har = df[['RV_lag1','RV_week','RV_month']].iloc[SEQ_LEN:t_idx+SEQ_LEN]\n",
        "        y_har = df['RV'].iloc[SEQ_LEN:t_idx+SEQ_LEN]\n",
        "\n",
        "        model_har = LinearRegression()\n",
        "        model_har.fit(X_har, y_har)\n",
        "\n",
        "        x_next = df[['RV_lag1','RV_week','RV_month']].iloc[t_idx+SEQ_LEN].values.reshape(1,-1)\n",
        "        har_pred = max(model_har.predict(x_next)[0], 1e-6)\n",
        "\n",
        "        # ================= DL (FULL RETRAIN EVERY DAY) =================\n",
        "        X_train = X[:t_idx]\n",
        "        y_train = y[:t_idx]\n",
        "\n",
        "        split = int(len(X_train)*0.8)\n",
        "        X_tr, X_val = X_train[:split], X_train[split:]\n",
        "        y_tr, y_val = y_train[:split], y_train[split:]\n",
        "\n",
        "        # Zero Data Leakage\n",
        "        data_scaler = StandardScaler()\n",
        "        X_tr_scaled = data_scaler.fit_transform(X_tr.reshape(-1, len(features))).reshape(X_tr.shape)\n",
        "        X_val_scaled = data_scaler.transform(X_val.reshape(-1, len(features))).reshape(X_val.shape)\n",
        "\n",
        "        # DataLoader (Mini-Batches)\n",
        "        train_dataset = TensorDataset(torch.Tensor(X_tr_scaled), torch.Tensor(y_tr))\n",
        "        train_loader = DataLoader(train_dataset, batch_size=64, shuffle=True)\n",
        "\n",
        "        model = DeepVolEngine(len(features)).to(DEVICE)\n",
        "        opt = optim.Adam(model.parameters(), lr=0.005)\n",
        "\n",
        "        X_val_t = torch.Tensor(X_val_scaled).to(DEVICE)\n",
        "        y_val_t = torch.Tensor(y_val).to(DEVICE)\n",
        "\n",
        "        best_loss = float('inf')\n",
        "        best_weights = None\n",
        "        patience = 5\n",
        "        no_improve = 0\n",
        "\n",
        "        # Limits for overfiting\n",
        "        for epoch in range(30):\n",
        "            model.train()\n",
        "            \n",
        "            for batch_x, batch_y in train_loader:\n",
        "                batch_x, batch_y = batch_x.to(DEVICE), batch_y.to(DEVICE)\n",
        "                opt.zero_grad(set_to_none=True)\n",
        "\n",
        "                if torch.cuda.is_available():\n",
        "                    with torch.amp.autocast('cuda'):\n",
        "                        out, _ = model(batch_x)\n",
        "                        loss = qlike_torch(out.squeeze(), batch_y)\n",
        "\n",
        "                    amp_scaler.scale(loss).backward()\n",
        "                    amp_scaler.unscale_(opt)\n",
        "                    nn_utils.clip_grad_norm_(model.parameters(), 1.0)\n",
        "                    amp_scaler.step(opt)\n",
        "                    amp_scaler.update()\n",
        "                else:\n",
        "                    out, _ = model(batch_x)\n",
        "                    loss = qlike_torch(out.squeeze(), batch_y)\n",
        "                    loss.backward()\n",
        "                    nn_utils.clip_grad_norm_(model.parameters(), 1.0)\n",
        "                    opt.step()\n",
        "\n",
        "            model.eval()\n",
        "            with torch.no_grad():\n",
        "                if torch.cuda.is_available():\n",
        "                    with torch.amp.autocast('cuda'):\n",
        "                        val_out, _ = model(X_val_t)\n",
        "                        val_loss = qlike_torch(val_out.squeeze(), y_val_t).item()\n",
        "                else:\n",
        "                    val_out, _ = model(X_val_t)\n",
        "                    val_loss = qlike_torch(val_out.squeeze(), y_val_t).item()\n",
        "\n",
        "            if val_loss < best_loss:\n",
        "                best_loss = val_loss\n",
        "                best_weights = copy.deepcopy(model.state_dict())\n",
        "                no_improve = 0\n",
        "            else:\n",
        "                no_improve += 1\n",
        "                if no_improve >= patience:\n",
        "                    break\n",
        "\n",
        "        if best_weights is not None:\n",
        "            model.load_state_dict(best_weights)\n",
        "\n",
        "        # ================= Test prediction =================\n",
        "        X_test_day = X[t_idx].reshape(1, SEQ_LEN, -1)\n",
        "        X_test_scaled = data_scaler.transform(X_test_day.reshape(-1, len(features))).reshape(X_test_day.shape)\n",
        "\n",
        "        model.eval()\n",
        "        with torch.no_grad():\n",
        "            if torch.cuda.is_available():\n",
        "                with torch.amp.autocast('cuda'):\n",
        "                    pred, _ = model(torch.Tensor(X_test_scaled).to(DEVICE))\n",
        "            else:\n",
        "                pred, _ = model(torch.Tensor(X_test_scaled).to(DEVICE))\n",
        "            dl_pred = max(pred.item(), 1e-6)\n",
        "\n",
        "        har_preds.append(har_pred)\n",
        "        dl_preds.append(dl_pred)\n",
        "        y_true.append(y[t_idx])\n",
        "\n",
        "    # ================= Results =================\n",
        "    har_preds = np.array(har_preds)\n",
        "    dl_preds = np.array(dl_preds)\n",
        "    y_true = np.array(y_true)\n",
        "\n",
        "    q_har = qlike(y_true, har_preds)\n",
        "    q_dl = qlike(y_true, dl_preds)\n",
        "\n",
        "    dm, p = diebold_mariano_test(y_true, har_preds, dl_preds, lag=1)\n",
        "\n",
        "    print(f\"\\n=== WYNIKI: {ticker} ===\")\n",
        "    print(f\"QLIKE HAR: {q_har:.6f}\")\n",
        "    print(f\"QLIKE DL : {q_dl:.6f}\")\n",
        "    print(f\"DM stat  : {dm:.4f}, p-value: {p:.4f}\\n\")"
      ]
    },
