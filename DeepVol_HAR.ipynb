        "id": "KwcoVbECkcv2"
      },
      "outputs": [],
      "source": [
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from arch import arch_model\n",
        "from scipy.stats import norm\n",
        "import copy\n",
        "\n",
        "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "def get_data():\n",
        "    def fetch(symbol):\n",
        "        df = yf.Ticker(symbol).history(start=\"2010-01-01\", end=\"2024-01-01\")\n",
        "        df['Ret'] = np.log(df['Close'] / df['Close'].shift(1))\n",
        "        df['Parkinson'] = ((np.log(df['High'] / df['Low'])**2) / (4 * np.log(2))) * 10000\n",
        "        return df.dropna()\n",
        "    return fetch(\"SPY\"), fetch(\"EPOL\")\n",
        "\n",
        "data_us, data_pl = get_data()\n",
        "\n",
        "class Attention(nn.Module):\n",
        "    def __init__(self, hidden_dim):\n",
        "        super().__init__()\n",
        "        self.attn = nn.Linear(hidden_dim * 2, 1)\n",
        "    def forward(self, x):\n",
        "        weights = F.softmax(self.attn(x).squeeze(-1), dim=1)\n",
        "        return torch.bmm(weights.unsqueeze(1), x).squeeze(1)\n",
        "\n",
        "class DeepVolModel(nn.Module):\n",
        "    def __init__(self, input_dim=2, hidden_dim=64):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(input_dim, hidden_dim, num_layers=2, batch_first=True, bidirectional=True, dropout=0.2)\n",
        "        self.attention = Attention(hidden_dim)\n",
        "        self.fc = nn.Sequential(nn.Linear(hidden_dim * 2, 1), nn.Softplus())\n",
        "    def forward(self, x):\n",
        "        lstm_out, _ = self.lstm(x)\n",
        "        return self.fc(self.attention(lstm_out))\n",
        "\n",
        "def create_seq(df, seq_len=10):\n",
        "    X, y = [], []\n",
        "    v, r2 = df['Parkinson'].values, (df['Ret'].values)**2\n",
        "    for i in range(len(df) - seq_len):\n",
        "        X.append(np.column_stack((v[i:i+seq_len], r2[i:i+seq_len])))\n",
        "        y.append(v[i+seq_len])\n",
        "    return torch.tensor(np.array(X), dtype=torch.float32).to(DEVICE), torch.tensor(np.array(y), dtype=torch.float32).to(DEVICE)\n",
        "\n",
        "X_us, y_us = create_seq(data_us)\n",
        "X_pl, y_pl = create_seq(data_pl)\n",
        "\n",
        "model = DeepVolModel().to(DEVICE)\n",
        "loss_fn = lambda p, t: torch.mean(t/p - torch.log(t/p) - 1)\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n",
        "\n",
        "for e in range(50):\n",
        "    model.train()\n",
        "    optimizer.zero_grad()\n",
        "    loss = loss_fn(model(X_us).squeeze(), y_us)\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "\n"
      ]
    },
