    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "5YQcOOavxSrX"
      },
      "outputs": [],
      "source": [
        "!pip install yfinance pandas numpy torch scikit-learn matplotlib scipy\n",
        "\n",
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from scipy.stats import t\n",
        "import matplotlib.pyplot as plt\n",
        "import warnings\n",
        "\n",
        "warnings.filterwarnings('ignore')\n",
        "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "torch.manual_seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "# --- 1. Static function ---\n",
        "\n",
        "def diebold_mariano_test(target, forecast_bench, forecast_model):\n",
        "    \"\"\"Rygorystyczny test DM dla funkcji straty QLIKE.\"\"\"\n",
        "    e_bench = (target / forecast_bench) - np.log(target / forecast_bench) - 1\n",
        "    e_model = (target / forecast_model) - np.log(target / forecast_model) - 1\n",
        "    d = e_bench - e_model\n",
        "\n",
        "    mean_d = np.mean(d)\n",
        "    var_d = np.var(d, ddof=1) / len(d)\n",
        "\n",
        "    if var_d == 0:\n",
        "        return 0, 1.0\n",
        "\n",
        "    dm_stat = mean_d / np.sqrt(var_d)\n",
        "    p_value = 2 * (1 - t.cdf(np.abs(dm_stat), df=len(d)-1))\n",
        "    return dm_stat, p_value\n",
        "\n",
        "def qlike_loss_numpy(target, forecast):\n",
        "    forecast = np.clip(forecast, a_min=1e-6, a_max=None)\n",
        "    target = np.clip(target, a_min=1e-6, a_max=None)\n",
        "    return np.mean(target / forecast - np.log(target / forecast) - 1)\n",
        "\n",
        "# --- 2. Archtecture (Bi-LSTM + Attention) ---\n",
        "\n",
        "class Attention(nn.Module):\n",
        "    def __init__(self, hidden_dim):\n",
        "        super().__init__()\n",
        "        self.attn = nn.Linear(hidden_dim * 2, 1)\n",
        "\n",
        "    def forward(self, x):\n",
        "        weights = F.softmax(self.attn(x).squeeze(-1), dim=1)\n",
        "        context = torch.bmm(weights.unsqueeze(1), x).squeeze(1)\n",
        "        return context, weights\n",
        "\n",
        "class DeepVolEngine(nn.Module):\n",
        "    def __init__(self, input_dim, hidden_dim=64, n_layers=2, dropout=0.3):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(input_dim, hidden_dim, num_layers=n_layers,\n",
        "                            batch_first=True, bidirectional=True, dropout=dropout)\n",
        "        self.attention = Attention(hidden_dim)\n",
        "        self.fc = nn.Sequential(\n",
        "            nn.Linear(hidden_dim * 2, 32),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(32, 1),\n",
        "            nn.Softplus() # Utrzymuje zmienność w rejonie wartości dodatnich\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        lstm_out, _ = self.lstm(x)\n",
        "        context, weights = self.attention(lstm_out)\n",
        "        return self.fc(context), weights\n",
        "\n",
        "# --- 3. Data ---\n",
        "\n",
        "def prepare_advanced_data(symbol, start=\"2010-01-01\", end=\"2024-01-01\"):\n",
        "    df = yf.Ticker(symbol).history(start=start, end=end)\n",
        "    df['Parkinson'] = ((np.log(df['High'] / df['Low'])**2) / (4 * np.log(2))) * 10000\n",
        "    df['Ret'] = np.log(df['Close'] / df['Close'].shift(1))\n",
        "    df['Neg_Ret'] = np.where(df['Ret'] < 0, df['Ret']**2, 0)\n",
        "\n",
        "    df['HV_5'] = df['Parkinson'].rolling(5).mean()\n",
        "    df['HV_22'] = df['Parkinson'].rolling(22).mean()\n",
        "\n",
        "    return df.dropna()\n",
        "\n",
        "def create_sequences(data, target_col, feature_cols, seq_len=15):\n",
        "    X, y = [], []\n",
        "    for i in range(len(data) - seq_len):\n",
        "        X.append(data[feature_cols].iloc[i:i+seq_len].values)\n",
        "        y.append(data[target_col].iloc[i+seq_len])\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "# --- 4. Main IF ---\n",
        "\n",
        "TICKERS = [\"EPOL\", \"SPY\", \"EWG\", \"EEM\"]\n",
        "SEQ_LEN = 15\n",
        "RESULTS = []\n",
        "\n",
        "print(\"Uruchamianie silnika badawczego...\")\n",
        "\n",
        "for ticker in TICKERS:\n",
        "    print(f\"\\n{'-'*20} PROCESOWANIE: {ticker} {'-'*20}\")\n",
        "    df = prepare_advanced_data(ticker)\n",
        "\n",
        "    features = ['Parkinson', 'Ret', 'Neg_Ret', 'HV_5', 'HV_22']\n",
        "    X, y = create_sequences(df, 'Parkinson', features, SEQ_LEN)\n",
        "\n",
        "    split_idx = int(len(X) * 0.8)\n",
        "    X_train, X_test = X[:split_idx], X[split_idx:]\n",
        "    y_train, y_test = y[:split_idx], y[split_idx:]\n",
        "\n",
        "    # ==========================================\n",
        "    # BENCHMARK model (HAR within OLS)\n",
        "    # ==========================================\n",
        "    X_train_har = X_train[:, -1, [0, 3, 4]]\n",
        "    X_test_har = X_test[:, -1, [0, 3, 4]]\n",
        "\n",
        "    har_model = LinearRegression()\n",
        "    har_model.fit(X_train_har, y_train)\n",
        "    har_forecasts = har_model.predict(X_test_har)\n",
        "\n",
        "    har_forecasts = np.clip(har_forecasts, a_min=1e-6, a_max=None)\n",
        "\n",
        "    # ==========================================\n",
        "    # DEEP LEARNING MODEL (Bi-LSTM + Attention)\n",
        "    # ==========================================\n",
        "    scaler = StandardScaler()\n",
        "    X_train_reshaped = X_train.reshape(-1, len(features))\n",
        "    X_train_scaled = scaler.fit_transform(X_train_reshaped).reshape(X_train.shape)\n",
        "\n",
        "    X_test_reshaped = X_test.reshape(-1, len(features))\n",
        "    X_test_scaled = scaler.transform(X_test_reshaped).reshape(X_test.shape)\n",
        "\n",
        "    train_loader = DataLoader(TensorDataset(torch.Tensor(X_train_scaled), torch.Tensor(y_train)),\n",
        "                              batch_size=32, shuffle=True)\n",
        "\n",
        "    model = DeepVolEngine(input_dim=len(features)).to(DEVICE)\n",
        "    optimizer = torch.optim.Adam(model.parameters(), lr=0.001, weight_decay=1e-5)\n",
        "\n",
        "    criterion = lambda p, t: torch.mean(t/p - torch.log(t/p) - 1)\n",
        "\n",
        "    model.train()\n",
        "    for epoch in range(50):\n",
        "        for batch_x, batch_y in train_loader:\n",
        "            batch_x, batch_y = batch_x.to(DEVICE), batch_y.to(DEVICE)\n",
        "            optimizer.zero_grad()\n",
        "            outputs, _ = model(batch_x)\n",
        "            loss = criterion(outputs.squeeze(), batch_y)\n",
        "            loss.backward()\n",
        "            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0),
        "            optimizer.step()\n",
        "\n",
        "    model.eval()\n",
        "    with torch.no_grad():\n",
        "        X_test_tensor = torch.Tensor(X_test_scaled).to(DEVICE)\n",
        "        dl_forecasts, _ = model(X_test_tensor)\n",
        "        dl_forecasts = dl_forecasts.cpu().numpy().flatten()\n",
        "        dl_forecasts = np.clip(dl_forecasts, a_min=1e-6, a_max=None)\n",
        "\n",
        "    # ==========================================\n",
        "    # Analysis\n",
        "    # ==========================================\n",
        "\n",
        "    q_har = qlike_loss_numpy(y_test, har_forecasts)\n",
        "    q_dl = qlike_loss_numpy(y_test, dl_forecasts)\n",
        "    imp = (q_har - q_dl) / q_har * 100\n",
        "    dm_s, p_v = diebold_mariano_test(y_test, har_forecasts, dl_forecasts)\n",
        "\n",
        "    RESULTS.append({\n",
        "        'Ticker': ticker,\n",
        "        'QLIKE_HAR': round(q_har, 4),\n",
        "        'QLIKE_DL': round(q_dl, 4),\n",
        "        'Gain_%': round(imp, 2),\n",
        "        'DM_Stat': round(dm_s, 2),\n",
        "        'P_Value': round(p_v, 4),\n",
        "        'Significant?': \"TAK\" if (p_v < 0.05 and imp > 0) else \"NIE\"\n",
        "    })\n",
        "\n",
        "# --- 5. Results ---\n",
        "res_df = pd.DataFrame(RESULTS)\n",
        "print(\"\\n\\n\" + \"=\"*70)\n",
        "print(\"WYNIKI ANALIZY PORÓWNAWCZEJ (PEŁEN RYGOR O-O-S)\")\n",
        "print(\"=\"*70)\n",
        "print(res_df.to_string(index=False))\n",
        "\n",
        "plt.figure(figsize=(16, 6))\n",
        "plt.plot(y_test[-150:], label='Realized Vol (Parkinson)', alpha=0.3, color='black')\n",
        "plt.plot(har_forecasts[-150:], label='HAR Benchmark', alpha=0.8, linestyle='--')\n",
        "plt.plot(dl_forecasts[-150:], label='Bi-LSTM DL-HAR', alpha=0.8, color='red')\n",
        "plt.title(f\"Porównanie Predykcji Ostatnie 150 Dni: {ticker}\")\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
